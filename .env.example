# Copy to .env and fill in your values. .env is git-ignored.

# GitHub personal access token — needs repo + pull_requests scope
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Anthropic API key — for the three reasoning passes
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Model to use for analysis (Haiku = fast + cheap; Sonnet = deeper reasoning)
REVIEW_MODEL=claude-3-5-haiku-20241022

# Post the review as a real GitHub comment? Set to false to dry-run locally.
POST_TO_GITHUB=true
